{
  "manifest_version": 3,
  "name": "Live Subtitle Translator",
  "version": "0.3.0",
  "description": "Translated subtitle overlay for QQ Video audio and TVer Japanese caption tracks.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "wss://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "wss://api.openai.com/*",
    "https://*.openai.azure.com/*",
    "wss://*.openai.azure.com/*",
    "https://*.services.ai.azure.com/*",
    "wss://*.services.ai.azure.com/*",
    "https://tracks.streaks.jp/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "QQ Live Subtitles",
    "default_popup": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://v.qq.com/*",
        "https://*.v.qq.com/*",
        "https://film.qq.com/*",
        "https://tver.jp/*",
        "https://*.tver.jp/*"
      ],
      "js": ["src/content/overlay.js"],
      "css": ["src/content/overlay.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/audio/worklet.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
